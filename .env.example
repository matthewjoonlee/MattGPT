# Copy to .env and fill in. .env is gitignored — never commit real values.

# Path to the OAuth client secret downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client ID > Desktop app).
GOOGLE_CLIENT_SECRET_PATH=credentials/client_secret.json

# Where the cached OAuth refresh token is stored after the first interactive
# consent. Created automatically on first run.
GOOGLE_TOKEN_PATH=credentials/token.json

# Path to the local SQLite database file.
DB_PATH=mattgpt.db
